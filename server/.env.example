MUA_CLIENT_TOKEN=replace-with-a-random-client-token
MUA_DEVICE_TOKEN=replace-with-a-random-shared-device-token

# MUA_DATA_DIR is required. start.sh sets it to server/data (SQLite: mua.sqlite3) and uses
# server/firebase-service-account.json when present. No path settings are needed.
# Docker sets MUA_DATA_DIR=/data. For FCM, mount the key and set its container path:
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json

# Optional override; defaults to the project ID from the credentials.
# MUA_FIREBASE_PROJECT_ID=your-firebase-project
